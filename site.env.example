PUBLIC_ORIGIN=https://optics.example.com
SUNCITY_DATA=/var/lib/suncity-optics
# SMTP credentials are provided by the shop's email provider.
# 587 uses STARTTLS; 465 uses SMTP over TLS. No plaintext SMTP is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional first-run account, created only when no accounts exist.
# Configure privately in the hosting dashboard. Do not put a real password in GitHub.
# ADMIN_USERNAME=tempadmin
# ADMIN_PASSWORD=
# IS_FREE_PREVIEW=1
