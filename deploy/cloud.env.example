# Copy PRIVATELY to cloud.env on the Pi, or enter these keys in Render Environment.
STORAGE_MODE=supabase
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_BUCKET=suncity-media
# Render uses its automatic RENDER_EXTERNAL_URL if PUBLIC_ORIGIN is omitted.
SUNCITY_DATA=/data
MAIL_AUTORUN=1
# Optional HTTPS alerts. Requires a provider account and authorized sender.
# RESEND_API_KEY=
# MAIL_FROM=Sun City Optics <bookings@your-verified-domain.example>
# If Supabase supplies a project-specific CA, store that CA on the server and set:
# PGSSLROOTCERT=/private/path/supabase-ca.crt
