[Unit]
Description=Deliver queued Sun City Optics email alerts
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/suncityoptics
EnvironmentFile=/var/www/html/suncityoptics/site.env
ExecStart=/usr/bin/python3 /var/www/html/suncityoptics/app.py mail
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/html/suncityoptics/data
