PUBLIC_ORIGIN=http://192.168.0.120:8081
SUNCITY_DATA=/var/www/html/suncityoptics/data
# SMTP credentials are provided by the shop's email provider.
# 587 uses STARTTLS; 465 uses SMTP over TLS. No plaintext SMTP is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional first-run account, created only when no accounts exist.
# Configure privately in the hosting dashboard. Do not put a real password in GitHub.
# ADMIN_USERNAME=tempadmin
# ADMIN_PASSWORD=
# IS_FREE_PREVIEW=1

# Local Pi mode is the default. Enable the following ONLY after successful migration:
# STORAGE_MODE=supabase
# DATABASE_URL=...
# SUPABASE_URL=...
# SUPABASE_SECRET_KEY=...
# SUPABASE_BUCKET=suncity-media
# Use MAIL_AUTORUN=0 on Pi when the systemd mail timer is enabled.
# MAIL_AUTORUN=0
# RESEND_API_KEY=...
# MAIL_FROM=...
